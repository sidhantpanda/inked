{
  "name": "@inked/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@inked/commons": "workspace:*",
    "@napi-rs/canvas": "^1.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@inked/eslint-config": "workspace:*",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
