PORT=3001
HOST=0.0.0.0
PHOTO_PAINTER_API_URL=https://YOUR_API_TO_PAINT_TO_DISPLAY
INKED_DB_PATH=.data/inked.db

# Google Calendar (OAuth 2.0, read-only). Create a "Web application" OAuth client
# in Google Cloud Console and register the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Make sure to enable this OAuth scope https://console.cloud.google.com/apis/api/calendar-json.googleapis.com/metrics
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/google/callback
